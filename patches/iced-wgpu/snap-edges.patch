+
+// Match the layer scissor (Rectangle::snap / f32::round), including at half pixels.
+// WGSL round can send ties to the even integer instead.
+fn snap_edge(edge: vec2<f32>) -> vec2<f32> {
+    let whole = trunc(edge);
+    return whole + sign(edge) * step(vec2(0.5), abs(edge - whole));
+}
