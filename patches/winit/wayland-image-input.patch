@@ -0,0 +1,354 @@
+//! Ordinary wl_data_device offers for file drops and image paste. Own dropped
+//! offers until their transfers finish, independently of the next drag/selection.
+mod uri_list;
+use super::{make_wid, state::WinitState, WindowId};
+use crate::event::WindowEvent;
+use ahash::AHashMap;
+use sctk::{
+    data_device_manager::ReadPipe,
+    reexports::{
+        calloop::{
+            self, channel,
+            timer::{TimeoutAction, Timer},
+            PostAction,
+        },
+        client::{
+            event_created_child,
+            protocol::{
+                wl_data_device::{self, WlDataDevice},
+                wl_data_device_manager::{DndAction, WlDataDeviceManager},
+                wl_data_offer::{self, WlDataOffer},
+                wl_seat::WlSeat,
+            },
+            Connection, Dispatch, Proxy, QueueHandle,
+        },
+    },
+};
+use std::{
+    cell::RefCell,
+    io,
+    os::fd::AsFd,
+    rc::Rc,
+    sync::{mpsc, Mutex},
+    time::Duration,
+};
+use uri_list::paths;
+
+const URI_MIME: &str = "text/uri-list";
+const IMAGE_MIMES: &[&str] = &["image/png", "image/jpeg", "image/webp", "image/gif"];
+type Reply = mpsc::Sender<io::Result<Option<Vec<u8>>>>;
+type OnImage = Box<dyn FnOnce() + Send>;
+static REQUESTS: Mutex<Option<channel::Sender<(usize, Reply, OnImage)>>> = Mutex::new(None);
+
+pub(crate) fn request_image_clipboard(
+    max_bytes: usize,
+    on_image: OnImage,
+) -> io::Result<mpsc::Receiver<io::Result<Option<Vec<u8>>>>> {
+    let (reply, receiver) = mpsc::channel();
+    REQUESTS
+        .lock()
+        .unwrap()
+        .as_ref()
+        .ok_or_else(|| io::Error::other("Wayland clipboard not initialized"))?
+        .send((max_bytes, reply, on_image))
+        .map_err(|_| io::Error::other("Wayland event loop closed"))?;
+    Ok(receiver)
+}
+
+pub struct OfferInfo {
+    mimes: Vec<String>,
+    action: DndAction,
+}
+impl Default for OfferInfo {
+    fn default() -> Self {
+        Self {
+            mimes: vec![],
+            action: DndAction::empty(),
+        }
+    }
+}
+struct Offer(WlDataOffer);
+impl Drop for Offer {
+    fn drop(&mut self) {
+        self.0.destroy();
+    }
+}
+impl Offer {
+    fn receive(&self, mime: &str) -> io::Result<ReadPipe> {
+        let (read, write) = rustix::pipe::pipe_with(rustix::pipe::PipeFlags::CLOEXEC)?;
+        self.0.receive(mime.to_owned(), write.as_fd());
+        Ok(read.into())
+    }
+}
+pub struct Device {
+    pub seat: sctk::reexports::client::backend::ObjectId,
+    proxy: WlDataDevice,
+    pending: AHashMap<sctk::reexports::client::backend::ObjectId, Offer>,
+    drag: Option<(Offer, WindowId)>,
+    selection: Option<Offer>,
+}
+impl Drop for Device {
+    fn drop(&mut self) {
+        if self.proxy.version() >= 2 {
+            self.proxy.release();
+        }
+    }
+}
+
+impl WinitState {
+    pub fn add_data_device(&mut self, qh: &QueueHandle<Self>, seat: &WlSeat) {
+        if let Some(manager) = &self.data_device_manager {
+            let proxy = manager.get_data_device(seat, qh, ());
+            self.data_devices.insert(
+                proxy.id(),
+                Device {
+                    seat: seat.id(),
+                    proxy,
+                    pending: Default::default(),
+                    drag: None,
+                    selection: None,
+                },
+            );
+        }
+    }
+    pub fn init_image_clipboard(&mut self) -> Result<(), calloop::Error> {
+        let (sender, receiver) = channel::channel();
+        self.loop_handle
+            .insert_source(receiver, |event, _, state| {
+                if let channel::Event::Msg((limit, reply, on_image)) = event {
+                    state.paste_image(limit, reply, on_image);
+                }
+            })
+            .map_err(|e| e.error)?;
+        *REQUESTS.lock().unwrap() = Some(sender);
+        Ok(())
+    }
+    fn paste_image(&mut self, limit: usize, reply: Reply, on_image: OnImage) {
+        // Follow the seat that delivered the latest key press, not hash-map order.
+        let selection = self
+            .clipboard_seat
+            .as_ref()
+            .and_then(|seat| {
+                self.data_devices
+                    .values()
+                    .find(|device| &device.seat == seat)
+            })
+            .and_then(|device| device.selection.as_ref());
+        let Some(offer) = selection else {
+            let _ = reply.send(Ok(None));
+            return;
+        };
+        let info = offer.0.data::<Mutex<OfferInfo>>().unwrap().lock().unwrap();
+        let mime = IMAGE_MIMES
+            .iter()
+            .find(|mime| info.mimes.iter().any(|m| m == **mime))
+            .copied();
+        let Some(mime) = mime else {
+            let result = if info.mimes.iter().any(|m| m.starts_with("image/")) {
+                Err(io::Error::other(
+                    "Copy a PNG, JPEG, WebP or GIF image instead",
+                ))
+            } else {
+                Ok(None)
+            };
+            let _ = reply.send(result);
+            return;
+        };
+        drop(info);
+        on_image();
+        match offer.receive(mime) {
+            Ok(pipe) => self.read_transfer(pipe, limit, move |result, _| {
+                let _ = reply.send(result.map(Some));
+            }),
+            Err(e) => {
+                let _ = reply.send(Err(e));
+            }
+        }
+    }
+    fn read_transfer(
+        &mut self,
+        pipe: ReadPipe,
+        limit: usize,
+        done: impl FnOnce(io::Result<Vec<u8>>, &mut Self) + 'static,
+    ) {
+        if let Err(e) = rustix::fs::fcntl_getfl(&pipe)
+            .and_then(|flags| rustix::fs::fcntl_setfl(&pipe, flags | rustix::fs::OFlags::NONBLOCK))
+        {
+            done(Err(e.into()), self);
+            return;
+        }
+        let completion = Rc::new(RefCell::new(Some(done)));
+        let finished = completion.clone();
+        let mut bytes = Vec::new();
+        let token = match self.loop_handle.insert_source(pipe, move |_, file, state| {
+            let mut buffer = [0; 16384];
+            let result = loop {
+                match rustix::io::read(&*file, &mut buffer) {
+                    Ok(0) => break Ok(std::mem::take(&mut bytes)),
+                    Ok(count) if bytes.len() + count <= limit => bytes.extend_from_slice(&buffer[..count]),
+                    Ok(_) => break Err(io::Error::other(format!("Transfer exceeds the {limit} byte limit; use a smaller image or fewer files"))),
+                    Err(rustix::io::Errno::AGAIN) => return PostAction::Continue,
+                    Err(rustix::io::Errno::INTR) => continue,
+                    Err(e) => break Err(e.into()),
+                }
+            };
+            finished.borrow_mut().take().unwrap()(result, state);
+            PostAction::Remove
+        }) {
+            Ok(token) => token,
+            Err(e) => { completion.borrow_mut().take().unwrap()(Err(io::Error::other(e.to_string())), self); return; }
+        };
+        let timeout = completion.clone();
+        if let Err(e) = self.loop_handle.insert_source(
+            Timer::from_duration(Duration::from_secs(10)),
+            move |_, _, state| {
+                if let Some(done) = timeout.borrow_mut().take() {
+                    state.loop_handle.remove(token);
+                    done(
+                        Err(io::Error::new(
+                            io::ErrorKind::TimedOut,
+                            "Image/file transfer timed out; copy or drag it again",
+                        )),
+                        state,
+                    );
+                }
+                TimeoutAction::Drop
+            },
+        ) {
+            self.loop_handle.remove(token);
+            completion.borrow_mut().take().unwrap()(Err(io::Error::other(e.to_string())), self);
+        }
+    }
+}
+
+impl Dispatch<WlDataDeviceManager, ()> for WinitState {
+    fn event(
+        _: &mut Self,
+        _: &WlDataDeviceManager,
+        _: sctk::reexports::client::protocol::wl_data_device_manager::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+    }
+}
+impl Dispatch<WlDataOffer, Mutex<OfferInfo>> for WinitState {
+    fn event(
+        _: &mut Self,
+        _: &WlDataOffer,
+        event: wl_data_offer::Event,
+        info: &Mutex<OfferInfo>,
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let mut info = info.lock().unwrap();
+        match event {
+            wl_data_offer::Event::Offer { mime_type } => info.mimes.push(mime_type),
+            wl_data_offer::Event::Action {
+                dnd_action: sctk::reexports::client::WEnum::Value(action),
+            } => info.action = action,
+            _ => {}
+        }
+    }
+}
+impl Dispatch<WlDataDevice, ()> for WinitState {
+    event_created_child!(WinitState, WlDataDevice, [0 => (WlDataOffer, Mutex::<OfferInfo>::default())]);
+    fn event(
+        state: &mut Self,
+        device: &WlDataDevice,
+        event: wl_data_device::Event,
+        _: &(),
+        _: &Connection,
+        _: &QueueHandle<Self>,
+    ) {
+        let device = state.data_devices.get_mut(&device.id()).unwrap();
+        match event {
+            wl_data_device::Event::DataOffer { id } => {
+                device.pending.insert(id.id(), Offer(id));
+            }
+            wl_data_device::Event::Enter {
+                serial,
+                surface,
+                id,
+                ..
+            } => {
+                device.drag = None;
+                if let Some(id) = id {
+                    let offer = device.pending.remove(&id.id()).unwrap();
+                    let window = make_wid(&surface);
+                    let supported = state.windows.borrow().contains_key(&window)
+                        && offer
+                            .0
+                            .data::<Mutex<OfferInfo>>()
+                            .unwrap()
+                            .lock()
+                            .unwrap()
+                            .mimes
+                            .iter()
+                            .any(|m| m == URI_MIME);
+                    offer
+                        .0
+                        .accept(serial, supported.then(|| URI_MIME.to_owned()));
+                    if offer.0.version() >= 3 {
+                        let action = if supported {
+                            DndAction::Copy
+                        } else {
+                            DndAction::empty()
+                        };
+                        offer.0.set_actions(action, action);
+                    }
+                    if supported {
+                        device.drag = Some((offer, window));
+                    }
+                }
+            }
+            wl_data_device::Event::Leave => {
+                device.drag = None;
+            }
+            wl_data_device::Event::Selection { id } => {
+                device.selection = id.map(|id| device.pending.remove(&id.id()).unwrap());
+            }
+            wl_data_device::Event::Drop => {
+                if let Some((offer, window)) = device.drag.take() {
+                    if offer.0.version() >= 3
+                        && offer
+                            .0
+                            .data::<Mutex<OfferInfo>>()
+                            .unwrap()
+                            .lock()
+                            .unwrap()
+                            .action
+                            != DndAction::Copy
+                    {
+                        return;
+                    }
+                    match offer.receive(URI_MIME) {
+                        Ok(pipe) => state.read_transfer(pipe, 1024 * 1024, move |result, state| {
+                            match result.and_then(|bytes| paths(&bytes)) {
+                                Ok(paths) => {
+                                    if state.windows.borrow().contains_key(&window) {
+                                        for path in paths {
+                                            state.events_sink.push_window_event(
+                                                WindowEvent::DroppedFile(path),
+                                                window,
+                                            );
+                                        }
+                                        state.dispatched_events = true;
+                                    }
+                                    if offer.0.version() >= 3 {
+                                        offer.0.finish();
+                                    }
+                                }
+                                Err(e) => tracing::warn!("Could not receive dropped files: {e}"),
+                            }
+                            // Ownership ends here, not at the next enter/leave event.
+                            drop(offer);
+                        }),
+                        Err(e) => tracing::warn!("Could not receive dropped files: {e}"),
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+}
