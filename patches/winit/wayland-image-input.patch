+/// Request a PNG, JPEG, WebP or GIF from the focused application's ordinary
+/// Wayland selection. Orbit extension: no clipboard-manager protocol is required.
+/// `on_image` runs on the event loop when a supported image MIME is selected,
+/// before the transfer starts. The callback must not block.
+/// Wait for the reply off the event-loop thread. `None` means no image is offered.
+#[cfg(wayland_platform)]
+pub fn request_image_clipboard(
+    max_bytes: usize,
+    on_image: impl FnOnce() + Send + 'static,
+) -> std::io::Result<std::sync::mpsc::Receiver<std::io::Result<Option<Vec<u8>>>>> {
+    crate::platform_impl::wayland::data_device::request_image_clipboard(max_bytes, Box::new(on_image))
+}
