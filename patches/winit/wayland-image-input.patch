+use std::{io, path::PathBuf};
+
+pub(super) fn paths(bytes: &[u8]) -> io::Result<Vec<PathBuf>> {
+    std::str::from_utf8(bytes)
+        .map_err(io::Error::other)?
+        .lines()
+        .filter(|line| !line.is_empty() && !line.starts_with('#'))
+        .map(|line| {
+            url::Url::parse(line)
+                .map_err(io::Error::other)?
+                .to_file_path()
+                .map_err(|_| io::Error::other(format!("Not a local file URI: {line}")))
+        })
+        .collect()
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn local_uri_lists_decode_without_accepting_remote_files() {
+        assert_eq!(
+            paths(b"# comment\r\nfile:///tmp/a%20b.png\r\nfile://localhost/tmp/%CE%BB.gif\r\n")
+                .unwrap(),
+            vec![PathBuf::from("/tmp/a b.png"), PathBuf::from("/tmp/λ.gif")]
+        );
+        assert!(paths(b"file://remote/tmp/private.png").is_err());
+        assert!(paths(b"https://example.com/image.png").is_err());
+        assert!(paths(b"file:///tmp/ok.png\n\xff").is_err());
+    }
+}
