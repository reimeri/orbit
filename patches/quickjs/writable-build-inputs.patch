Keep copied build inputs writable when the patched source is in the Nix store.
fs::copy preserves mode 0444; a subsequent build-script execution sharing
OUT_DIR then fails with PermissionDenied. Read/write creates normal build files
without changing source permissions or touching the Cargo registry.

--- a/build.rs
+++ b/build.rs
@@ -207,10 +207,19 @@
     }
 
     for file in source_files.iter().chain(header_files.iter()) {
-        fs::copy(src_dir.join(file), out_dir.join(file))
-            .expect("Unable to copy source; try 'git submodule update --init'");
-    }
-    fs::copy("quickjs.bind.h", out_dir.join("quickjs.bind.h")).expect("Unable to copy source");
+        // fs::copy preserves read-only source permissions (e.g. in the Nix
+        // store), preventing a later build-script run from overwriting inputs.
+        fs::write(
+            out_dir.join(file),
+            fs::read(src_dir.join(file)).expect("Unable to read bundled QuickJS source"),
+        )
+        .expect("Unable to write QuickJS build input");
+    }
+    fs::write(
