+// Like cosmic-text's cursor_glyph_opt, distribute a ligature's advance over
+// its graphemes. Keep iced's float coordinates and affinity-aware row choice:
+// cosmic-text's cursor_position rounds to integers and searches visible runs
+// without considering affinity at a wrap boundary.
+fn caret_x(
+    line: &cosmic_text::LayoutLine,
+    text: &str,
+    cursor: cosmic_text::Cursor,
+) -> f32 {
+    let Some(start) = line.glyphs.iter().map(|glyph| glyph.start).min() else {
+        return 0.0;
+    };
+    let end = line.glyphs.iter().map(|glyph| glyph.end).max().unwrap();
+    // A wrapped-away space belongs visually to the preceding row's end.
+    let index = cursor.index.clamp(start, end);
+    let clusters = || {
+        line.glyphs
+            .chunk_by(|a, b| a.start == b.start && a.end == b.end)
+    };
+    let cluster = clusters()
+        .find(|cluster| {
+            let glyph = &cluster[0];
+            match cursor.affinity {
+                cosmic_text::Affinity::Before => {
+                    glyph.start < index && index <= glyph.end
+                }
+                cosmic_text::Affinity::After => {
+                    glyph.start <= index && index < glyph.end
+                }
+            }
+        })
+        .or_else(|| {
+            clusters().find(|cluster| {
+                let glyph = &cluster[0];
+                glyph.start <= index && index <= glyph.end
+            })
+        })
+        .expect("Cursor should intersect a cluster in its visual line");
+
+    cluster_x(cluster, text, index)
+}
+
+// Shared by the caret and selection endpoints, so both use the same grapheme
+// boundaries even when a shaping cluster contains several glyphs.
+fn cluster_x(
+    cluster: &[cosmic_text::LayoutGlyph],
+    text: &str,
+    index: usize,
+) -> f32 {
+    let glyph = &cluster[0];
+    // A shaping cluster can contain several glyphs (for example, a ligature
+    // plus a combining mark). Use the whole cluster's advance, not whichever
+    // glyph happened to be found first.
+    let (left, right) = cluster.iter().fold(
+        (glyph.x, glyph.x + glyph.w),
+        |(left, right), other| {
+            (left.min(other.x), right.max(other.x + other.w))
+        },
+    );
+    let width = right - left;
+
+    let offset = if index == glyph.start {
+        0.0
+    } else if index == glyph.end {
+        width
+    } else {
+        let cluster = &text[glyph.start..glyph.end];
+        let total = cluster.graphemes(true).count();
+        let before = cluster
+            .grapheme_indices(true)
+            .take_while(|(i, _)| glyph.start + i < index)
+            .count();
+
+        width * before as f32 / total as f32
+    };
+
+    if glyph.level.is_rtl() {
+        right - offset
+    } else {
+        left + offset
+    }
+}
