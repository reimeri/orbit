+    /// Scroll to a logical line and a fraction of its laid-out height, without
+    /// moving the caret or shaping intervening offscreen lines.
+    pub fn scroll_to(&mut self, line: usize, fraction: f32) {
+        self.with_internal_mut(|internal| {
+            let mut fonts = text::font_system().write().expect("Write font system");
+            let buffer = buffer_mut_from_editor(&mut internal.editor);
+            let line = line.min(buffer.lines.len() - 1);
+            let line_height = buffer.metrics().line_height;
+            let height: f32 = buffer.line_layout(fonts.raw(), line)
+                .expect("valid scroll line")
+                .iter()
+                .map(|row| row.line_height_opt.unwrap_or(line_height))
+                .sum();
+            internal.editor.set_scroll(cosmic_text::Scroll::new(
+                line, height * fraction.clamp(0.0, 1.0), 0.0,
+            ));
+        });
+    }
