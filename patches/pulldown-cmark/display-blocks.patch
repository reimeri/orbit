+    // Like fenced code, math is opaque to inline Markdown and respects containers.
+    // Keep unfinished blocks verbatim so incremental reparsing can finish them.
+    fn parse_display_block(&mut self, start: usize, close: &str) -> usize {
+        let bytes = self.text.as_bytes();
+        let mut ix = start + 2;
+        let mut body = String::new();
+        loop {
+            let end = ix + scan_nextline(&bytes[ix..]);
+            let line = &self.text[ix..end];
+            if let Some(last) = line.trim_end().strip_suffix(close) {
+                if last.bytes().rev().take_while(|&c| c == b'\\').count() % 2 == 0 {
+                    body.push_str(last);
+                    self.tree.append(Item {
+                        start,
+                        end,
+                        body: ItemBody::Math(self.allocs.allocate_cow(body.into()), true),
+                    });
+                    return end;
+                }
+            }
+            body.push_str(line);
+            let mut ls = LineStart::new(&bytes[end..]);
+            if end == bytes.len()
+                || end - start >= 8192
+                || scan_containers(&self.tree, &mut ls, self.options.has_gfm_footnotes())
+                    < self.tree.spine_len()
+                || scan_blank_line(&bytes[end + ls.bytes_scanned()..]).is_some()
+            {
+                body.insert_str(0, &self.text[start..start + 2]);
