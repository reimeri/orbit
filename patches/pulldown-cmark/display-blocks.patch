+fn display_closer(bytes: &[u8]) -> Option<&'static str> {
+    if bytes.starts_with(b"$$") {
+        Some("$$")
+    } else if bytes.starts_with(br"\[") {
+        Some(r"\]")
+    } else {
+        None
+    }
