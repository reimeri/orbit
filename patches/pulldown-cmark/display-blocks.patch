+                    start,
+                    end,
+                    body: ItemBody::SynthesizeText(self.allocs.allocate_cow(body.trim_end_matches(['\r', '\n']).to_owned().into())),
+                });
+                self.pop(end);
+                return end;
+            }
+            ix = end + ls.bytes_scanned();
+        }
+    }
